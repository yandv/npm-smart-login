{
  "name": "npm-smart-login",
  "version": "1.0.0",
  "description": "Keep several npm and pnpm accounts on one machine, with 90-day granular access tokens.",
  "author": "yandv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yandv/npm-smart-login.git"
  },
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "npm-smart-login": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [],
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "chalk": "^6.0.0",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@types/node": "^26.3.0",
    "fast-check": "4.10.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "5.1.1"
  }
}
